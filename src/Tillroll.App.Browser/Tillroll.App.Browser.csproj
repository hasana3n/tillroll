<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <!-- [JSImport]/[JSExport] source generators require unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Thin browser head over the shared Avalonia app; the browser transports (Web Serial / WebUSB /
         WebSocket) come from Tillroll.Transports.Browser. -->
    <ProjectReference Include="..\Tillroll.App\Tillroll.App.csproj" />
    <ProjectReference Include="..\Tillroll.Transports.Browser\Tillroll.Transports.Browser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- The shared transports.js, linked into wwwroot (served at /transports.js). -->
    <Content Include="..\Tillroll.Transports.Browser\wwwroot\transports.js"
             Link="wwwroot/transports.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
