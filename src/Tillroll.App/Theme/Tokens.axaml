<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tillroll design tokens. One dark world on every platform: concourse black with signage amber as the
         only accent. Amber marks selection, focus and new arrivals and nothing else; green, red and amber
         appear only where they report state. See DESIGN.md. -->

    <!-- Surfaces -->
    <Color x:Key="Ground">#141416</Color>
    <Color x:Key="Panel">#101012</Color>
    <Color x:Key="Raised">#1E1E21</Color>
    <Color x:Key="Hover">#26262A</Color>
    <Color x:Key="Pressed">#2E2E33</Color>
    <Color x:Key="Border">#232327</Color>
    <Color x:Key="ControlBorder">#3A3A3E</Color>

    <!-- Ink -->
    <Color x:Key="Ink">#F4F4F5</Color>
    <Color x:Key="InkMuted">#A1A1AA</Color>
    <Color x:Key="InkFaint">#8A8C92</Color>
    <Color x:Key="InkOnAccent">#17130A</Color>

    <!-- Signal -->
    <Color x:Key="Accent">#F2B33D</Color>
    <Color x:Key="AccentHover">#F6C462</Color>
    <Color x:Key="Positive">#44A282</Color>
    <Color x:Key="PositiveInk">#5FC39C</Color>
    <Color x:Key="PositiveTint">#1B2828</Color>
    <Color x:Key="Negative">#E5566F</Color>
    <Color x:Key="NegativeTint">#2C1A20</Color>
    <Color x:Key="Warning">#D9A441</Color>
    <Color x:Key="WarningTint">#2A2416</Color>
    <Color x:Key="Paper">#FFFFFF</Color>

    <SolidColorBrush x:Key="GroundBrush" Color="{StaticResource Ground}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource Panel}"/>
    <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource Raised}"/>
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource Hover}"/>
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource Pressed}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource Border}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{StaticResource ControlBorder}"/>
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
    <SolidColorBrush x:Key="InkMutedBrush" Color="{StaticResource InkMuted}"/>
    <SolidColorBrush x:Key="InkFaintBrush" Color="{StaticResource InkFaint}"/>
    <SolidColorBrush x:Key="InkOnAccentBrush" Color="{StaticResource InkOnAccent}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}"/>
    <SolidColorBrush x:Key="PositiveBrush" Color="{StaticResource Positive}"/>
    <SolidColorBrush x:Key="PositiveInkBrush" Color="{StaticResource PositiveInk}"/>
    <SolidColorBrush x:Key="PositiveTintBrush" Color="{StaticResource PositiveTint}"/>
    <SolidColorBrush x:Key="NegativeBrush" Color="{StaticResource Negative}"/>
    <SolidColorBrush x:Key="NegativeTintBrush" Color="{StaticResource NegativeTint}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningTintBrush" Color="{StaticResource WarningTint}"/>
    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource Paper}"/>

    <!-- Type: Public Sans for the interface, JetBrains Mono (the receipt face) for every figure. Both embedded,
         so Windows, Linux, macOS and the browser render the same letters. -->
    <FontFamily x:Key="UiFont">avares://Tillroll.App/Assets/Fonts#Public Sans</FontFamily>
    <FontFamily x:Key="MonoFont">avares://Tillroll.App/Assets/Fonts#JetBrains Mono</FontFamily>
    <x:Double x:Key="FontSmall">12</x:Double>
    <x:Double x:Key="FontBody">13</x:Double>
    <x:Double x:Key="FontSection">16</x:Double>
    <x:Double x:Key="FontTitle">20</x:Double>

    <!-- Shape -->
    <CornerRadius x:Key="CardRadius">6</CornerRadius>
    <CornerRadius x:Key="PillRadius">999</CornerRadius>
    <CornerRadius x:Key="ChipRadius">4</CornerRadius>

    <!-- Fluent overrides, so the stock controls speak the same language. -->
    <Color x:Key="SystemAccentColor">#F2B33D</Color>
    <Color x:Key="SystemAccentColorLight1">#F6C462</Color>
    <Color x:Key="SystemAccentColorLight2">#F8D088</Color>
    <Color x:Key="SystemAccentColorLight3">#FADCA8</Color>
    <Color x:Key="SystemAccentColorDark1">#D99A28</Color>
    <Color x:Key="SystemAccentColorDark2">#B07C1E</Color>
    <Color x:Key="SystemAccentColorDark3">#8A6016</Color>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

    <SolidColorBrush x:Key="SystemControlFocusVisualPrimaryBrush" Color="#F2B33D"/>
    <SolidColorBrush x:Key="SystemControlFocusVisualSecondaryBrush" Color="#00000000"/>

    <!-- Switches report state, so "on" is the positive green, never the accent. -->
    <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#44A282"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#4FB491"/>
    <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#3C9174"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#44A282"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#101012"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#101012"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#101012"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#5A5A60"/>
    <SolidColorBrush x:Key="ToggleSwitchStrokeOffPointerOver" Color="#7A7A80"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="ToggleSwitchKnobFillOffPointerOver" Color="#F4F4F5"/>

    <SolidColorBrush x:Key="TextControlBackground" Color="#101012"/>
    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="#101012"/>
    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="#101012"/>
    <SolidColorBrush x:Key="TextControlBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="#55555B"/>
    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="#F2B33D"/>
    <SolidColorBrush x:Key="TextControlForeground" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#8A8C92"/>
    <SolidColorBrush x:Key="TextControlSelectionHighlightColor" Color="#80F2B33D"/>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1</Thickness>
    <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="#101012"/>
    <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="#232327"/>
    <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#A1A1AA"/>

    <SolidColorBrush x:Key="ComboBoxBackground" Color="#101012"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#1E1E21"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#26262A"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#55555B"/>
    <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#101012"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#232327"/>
    <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#A1A1AA"/>
    <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#6A6A70"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1E1E21"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#26262A"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#2E2E33"/>
    <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#26262A"/>

    <SolidColorBrush x:Key="ToolTipBackground" Color="#26262A"/>
    <SolidColorBrush x:Key="ToolTipForeground" Color="#F4F4F5"/>
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#3A3A3E"/>

    <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#1E1E21"/>
    <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#26262A"/>
    <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#2E2E33"/>
    <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#1E1E21"/>
    <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#3A3A3E"/>

    <SolidColorBrush x:Key="ScrollBarThumbFill" Color="#3A3A3E"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPointerOver" Color="#55555B"/>
    <SolidColorBrush x:Key="ScrollBarThumbFillPressed" Color="#6A6A70"/>
</ResourceDictionary>
