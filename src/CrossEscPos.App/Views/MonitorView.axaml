<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CrossEscPos.App.Monitor"
             xmlns:tr="using:CrossEscPos.App.Transports"
             xmlns:controls="using:CrossEscPos.Controls"
             x:Class="CrossEscPos.App.Views.MonitorView"
             x:DataType="vm:MonitorViewModel"
             Foreground="{DynamicResource InkBrush}"
             FontFamily="{DynamicResource UiFont}"
             FontSize="13">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardRadius}"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>
        <Style Selector="UniformGrid.jobs > Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0 0 8 8"/>
        </Style>
        <Style Selector="ListBox.log">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="4 3"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Margin="20 20 20 24" Spacing="22">
        <StackPanel Spacing="4">
            <TextBlock Classes="h2" Text="Monitor"/>
            <TextBlock Classes="muted" TextWrapping="Wrap"
                       Text="A test client. It prints to the emulator the way your app would, and shows the status the emulator reports back."/>
        </StackPanel>

        <!-- Connection -->
        <StackPanel>
            <TextBlock Classes="group" Text="Connect"/>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <!-- Transport mode (hidden when there's only one, e.g. the browser proxy). Locked while connected. -->
                    <StackPanel Spacing="6" IsVisible="{Binding HasModes}">
                        <TextBlock Classes="label" Text="Connect over"/>
                        <ComboBox IsEnabled="{Binding !IsConnected}" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                                  AutomationProperties.Name="Connect over"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Fields}" IsEnabled="{Binding !IsConnected}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="tr:TransportField">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="label" Text="{Binding Label}"/>
                                    <ComboBox IsVisible="{Binding IsDropdown}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value}"/>
                                    <TextBox IsVisible="{Binding !IsDropdown}" Text="{Binding Value}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0 4 0 0">
                        <Button Content="{Binding ConnectButtonText}" Command="{Binding ToggleConnectCommand}"
                                Classes.primary="{Binding !IsConnected}" Classes.ghost="{Binding IsConnected}"/>
                        <Button Classes="ghost" Command="{Binding RefreshCommand}" AutomationProperties.Name="Find devices again"
                                IsVisible="{Binding CanRefresh}" IsEnabled="{Binding !IsConnected}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <controls:IconView Width="14" Height="14" Data="{DynamicResource Icon.Refresh}"/>
                                <TextBlock Text="Find devices again"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- What the emulator reports back -->
        <StackPanel>
            <TextBlock Classes="group" Text="Printer reports"/>
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Classes="title" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding Indicators}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatusIndicator">
                                <Grid ColumnDefinitions="Auto,110,*" Height="26">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Color}" VerticalAlignment="Center" Margin="0 0 10 0"/>
                                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Label}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" FontWeight="Medium" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Test jobs -->
        <StackPanel>
            <TextBlock Classes="group" Text="Send a test job"/>
            <UniformGrid Classes="jobs" Columns="2" Margin="0 0 -8 -8">
                <Button Classes="ghost" Content="Sample receipt" Command="{Binding SendSampleCommand}"/>
                <Button Classes="ghost" Content="All barcodes" Command="{Binding SendBarcodesCommand}"/>
                <Button Classes="ghost" Content="QR, PDF417, Aztec" Command="{Binding SendQrCommand}"/>
                <Button Classes="ghost" Content="Full feature test" Command="{Binding SendFullTestCommand}"/>
                <Button Classes="ghost" Content="Open cash drawer" Command="{Binding OpenDrawerCommand}"/>
                <Button Classes="ghost" Content="Sound the buzzer" Command="{Binding BeepCommand}"/>
                <Button Classes="ghost" Content="Cut" Command="{Binding CutCommand}"/>
            </UniformGrid>
        </StackPanel>

        <!-- Log -->
        <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="0 0 0 4">
                <TextBlock Classes="group" Text="Activity" Margin="0" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Classes="icon" Click="OnCopyLog"
                        ToolTip.Tip="Copy the activity log" AutomationProperties.Name="Copy the activity log">
                    <controls:IconView Width="15" Height="15" Data="{DynamicResource Icon.Copy}"/>
                </Button>
            </Grid>
            <Border Classes="card" Padding="6">
                <ListBox Classes="log" ItemsSource="{Binding Log}" Height="220">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <SelectableTextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource InkMutedBrush}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
