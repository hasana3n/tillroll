<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/Icon/icon.ico</ApplicationIcon>
    <AssemblyName>Tillroll</AssemblyName>
    <!-- Windows builds use the Windows target framework so the Bluetooth servers can use the WinRT APIs.
         Building for a win-* runtime (also from Linux, as the release workflow does) or building on Windows
         without a runtime selects it; everything else stays on plain net10.0 (BlueZ on Linux). -->
    <TargetFramework Condition="'$(RuntimeIdentifier)' != '' And $(RuntimeIdentifier.StartsWith('win'))">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared Avalonia app (App, MainView, MainViewModel, RenderBackend) — brings Core, Controls,
         and the render backends transitively. -->
    <ProjectReference Include="..\Tillroll.App\Tillroll.App.csproj" />
    <!-- Desktop-only transports (TCP listener + serial reader) used by the desktop connections panel. -->
    <ProjectReference Include="..\Tillroll.Transports\Tillroll.Transports.csproj" />
    <!-- Bluetooth printer emulation: Classic SPP (Android) and BLE (iPhone); WinRT on Windows, BlueZ on Linux. -->
    <ProjectReference Include="..\Tillroll.Transports.Bluetooth\Tillroll.Transports.Bluetooth.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- App icon embedded as an Avalonia resource so the window can load it at runtime. -->
    <AvaloniaResource Include="Assets/Icon/icon.png" />
    <AvaloniaResource Include="Assets/Icon/icon-256.png" />
  </ItemGroup>

  <!-- The target framework is chosen from the runtime while the project is read, before a publish profile's
       RuntimeIdentifier is known. Without -r on the command line a Linux build would silently get the Windows
       framework and lose Bluetooth (BlueZ), so stop it instead. -->
  <Target Name="CheckTargetFrameworkMatchesRuntime" BeforeTargets="Build;Publish"
          Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win')) And $(TargetFramework.Contains('-windows'))">
    <Error Text="Building for $(RuntimeIdentifier) picked $(TargetFramework). Pass the runtime on the command line too: dotnet publish src/Tillroll.App.Desktop -r $(RuntimeIdentifier) -p:PublishProfile=..." />
  </Target>

  <!-- A single-file build ships one executable: leave out the native libraries' debug symbols that SkiaSharp and
       HarfBuzzSharp would otherwise copy next to it. -->
  <Target Name="DropNativeSymbolsFromSingleFile" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- LibUsbDotNet (the Monitor's direct USB printing) is LGPL-3.0: ship it beside the executable rather than inside
       it, so anyone can replace it with their own build as the licence requires. See THIRD-PARTY-NOTICES.md. -->
  <Target Name="KeepLgplLibraryBesideSingleFile" AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(PublishSingleFile)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Update="@(ResolvedFileToPublish)" Condition="'%(Filename)' == 'LibUsbDotNet'"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
