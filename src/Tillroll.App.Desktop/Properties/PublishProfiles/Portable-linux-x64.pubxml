<Project>
  <!-- A portable build: one executable with the .NET runtime and the native libraries (Skia, HarfBuzz, ANGLE) inside.
       Nothing to install; copy it anywhere and run it. Use:
         dotnet publish src/Tillroll.App.Desktop -r linux-x64 -p:PublishProfile=Portable-linux-x64
       (-r is needed as well: the project picks its target framework from the runtime before the profile is read.)
       The native libraries are unpacked to a temp folder on first start, so the very first
       launch takes a little longer. Not trimmed: Avalonia and the transports load types by reflection. -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)/../../publish/portable-linux-x64/</PublishDir>
  </PropertyGroup>
</Project>
