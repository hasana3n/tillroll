<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emu="using:CrossEscPos.Emulator"
             xmlns:controls="using:CrossEscPos.Controls"
             x:Class="CrossEscPos.Controls.PrinterStatePanel">

    <UserControl.Styles>
        <Style Selector="TextBlock.row-title">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="TextBlock.row-note">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="LineHeight" Value="17"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0 2 0 0"/>
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
            <Setter Property="Margin" Value="0 22 0 10"/>
        </Style>
        <Style Selector="Grid.row">
            <Setter Property="Margin" Value="0 0 0 14"/>
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="OnContent" Value="{x:Null}"/>
            <Setter Property="OffContent" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="12 -6 0 0"/>
        </Style>

        <!-- Segmented control: plain radio buttons in a track; the checked one is lifted and underlined by the
             one-pixel accent line used for every selection in the app. -->
        <Style Selector="RadioButton.segment">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="face" Background="Transparent" CornerRadius="5" Height="28">
                        <Panel>
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Rectangle Name="line" Height="1" VerticalAlignment="Bottom" Margin="14 0 14 5"
                                       Fill="{DynamicResource AccentBrush}" IsVisible="False"/>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.segment:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked">
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Border#face">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
        </Style>
        <Style Selector="RadioButton.segment:checked /template/ Rectangle#line">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <Style Selector="RadioButton.segment:focus-visible /template/ Border#face">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- DataContext is the bound PrinterState, so every control two-way binds to it directly. The error
             choices come from the panel itself (RelativeSource). -->
        <StackPanel x:DataType="emu:PrinterState" Margin="0 0 14 0"
                    DataContext="{Binding State, RelativeSource={RelativeSource AncestorType=controls:PrinterStatePanel}}">

            <TextBlock Classes="group" Text="Power and cover" Margin="0 0 0 10"/>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="row-title" Text="Online"/>
                    <TextBlock Classes="row-note" Text="Accepts jobs and answers status queries."/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding Online, Mode=TwoWay}"
                              AutomationProperties.Name="Online"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="row-title" Text="Cover open"/>
                    <TextBlock Classes="row-note" Text="Prints are dropped while the lid is up."/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding CoverOpen, Mode=TwoWay}"
                              AutomationProperties.Name="Cover open"/>
            </Grid>

            <TextBlock Classes="group" Text="Paper"/>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="7" Padding="2">
                <UniformGrid Columns="3">
                    <RadioButton Classes="segment" GroupName="paper" Content="Plenty"
                                 IsChecked="{Binding Paper, Mode=TwoWay, Converter={x:Static controls:EnumEqualsConverter.Instance}, ConverterParameter=Adequate}"/>
                    <RadioButton Classes="segment" GroupName="paper" Content="Near end"
                                 IsChecked="{Binding Paper, Mode=TwoWay, Converter={x:Static controls:EnumEqualsConverter.Instance}, ConverterParameter=NearEnd}"/>
                    <RadioButton Classes="segment" GroupName="paper" Content="Out"
                                 IsChecked="{Binding Paper, Mode=TwoWay, Converter={x:Static controls:EnumEqualsConverter.Instance}, ConverterParameter=Out}"/>
                </UniformGrid>
            </Border>
            <TextBlock Classes="row-note" Margin="0 8 0 0"
                       Text="Near end still prints and warns the app. Out drops every job."/>

            <TextBlock Classes="group" Text="Error"/>
            <ComboBox SelectedItem="{Binding Error, Mode=TwoWay}" HorizontalAlignment="Stretch"
                      AutomationProperties.Name="Error"
                      ItemsSource="{Binding ErrorStates, RelativeSource={RelativeSource AncestorType=controls:PrinterStatePanel}}"/>
            <TextBlock Classes="row-note" Margin="0 8 0 0"
                       Text="Any error drops prints until it is cleared."/>

            <TextBlock Classes="group" Text="Cash drawer and buttons"/>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="row-title" Text="Drawer open"/>
                    <TextBlock Classes="row-note" Text="The drawer sensor your app reads back."/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding DrawerOpen, Mode=TwoWay}"
                              AutomationProperties.Name="Drawer open"/>
            </Grid>
            <Grid Classes="row" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Classes="row-title" Text="Feed button held"/>
                    <TextBlock Classes="row-note" Text="Reported in the printer's status replies."/>
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding FeedButtonPressed, Mode=TwoWay}"
                              AutomationProperties.Name="Feed button held"/>
            </Grid>

            <TextBlock Classes="row-note" Margin="0 10 0 0"
                       Text="These settings drive the status commands (DLE EOT, GS r) and Automatic Status Back (GS a)."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
